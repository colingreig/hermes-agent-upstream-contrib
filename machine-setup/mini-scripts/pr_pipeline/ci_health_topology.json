{
  "schema_version": 1,
  "description": "Hermes-hosted hermes-ci VM topology and fail-closed recovery policy for ci_health_watch.py.",
  "no_agent_interval_seconds": 300,
  "vm": {
    "name": "hermes-ci",
    "status_command": ["orb", "list", "--format", "json"],
    "boot_id_command": ["orb", "exec", "-m", "hermes-ci", "cat", "/proc/sys/kernel/random/boot_id"],
    "uptime_command": ["orb", "exec", "-m", "hermes-ci", "cut", "-d.", "-f1", "/proc/uptime"],
    "managed_commands": {
      "start": ["orb", "start", "hermes-ci"],
      "stop": ["orb", "stop", "hermes-ci"],
      "restart": ["orb", "restart", "hermes-ci"]
    }
  },
  "expected_runners": [
    {
      "repo": "colingreig/jdmbuysell-v4",
      "name": "hermes-jdmbuysell-v4",
      "listener_command": ["/home/colingreig/actions-runner/jdmbuysell-v4/bin/Runner.Listener", "run"]
    },
    {
      "repo": "colingreig/topdynamicspartners",
      "name": "hermes-topdynamicspartners",
      "listener_command": ["/home/colingreig/actions-runner/topdynamicspartners/bin/Runner.Listener", "run"]
    },
    {
      "repo": "colingreig/elevatoruptime.com",
      "name": "hermes-elevatoruptime.com",
      "listener_command": ["/home/colingreig/actions-runner/elevatoruptime.com/bin/Runner.Listener", "run"]
    }
  ],
  "recovery_allowlist": [
    {
      "repo": "colingreig/jdmbuysell-v4",
      "workflow": "Dead-image monitor",
      "event": "schedule",
      "max_reruns": 1
    }
  ]
}
