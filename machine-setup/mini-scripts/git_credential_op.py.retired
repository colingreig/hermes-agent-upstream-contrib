#!/usr/bin/env python3
"""Resolve Colin's personal GitHub PAT from 1Password and print it to stdout.

Used by git_credential_op.sh, the git credential helper wired into Colin's
own ~/.gitconfig for https://github.com. Lets the mini push/fetch personal
repos (e.g. colingreig/brain) on its own -- no MacBook relay, no `gh` CLI
required (gh is not installed on the mini).

Resolves op://Dev Toolbox/dev/GITHUB_PERSONAL_ACCESS_TOKEN via the same
1Password service-account SDK path as op_sdk_resolve.py (never the `op`
CLI -- see that file's docstring for why). Nothing is cached to disk; the
token is re-resolved on every git credential request.
"""
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.hermes/scripts"))
from op_sdk_resolve import resolve_refs  # noqa: E402

REF = "op://Dev Toolbox/dev/GITHUB_PERSONAL_ACCESS_TOKEN"


def main() -> None:
    try:
        result = resolve_refs([REF])
    except Exception as exc:  # fail open, matching op_sdk_resolve's contract
        print(f"git_credential_op: resolve failed: {exc}", file=sys.stderr)
        sys.exit(1)
    token = result.get(REF)
    if not token:
        print("git_credential_op: token not resolved", file=sys.stderr)
        sys.exit(1)
    sys.stdout.write(token)


if __name__ == "__main__":
    main()
