#!/usr/bin/env bash
# Git credential helper for Colin's personal GitHub account (colingreig) on
# the mini. Resolves the personal-access-token fresh from 1Password
# ("Dev Toolbox/dev" vault, GITHUB_PERSONAL_ACCESS_TOKEN field) on every
# request, so interactive/cron git operations against personal repos (e.g.
# colingreig/brain) work without `gh` CLI (not installed on the mini) or a
# MacBook relay.
#
# Wired in via Colin's own ~/.gitconfig [credential "https://github.com"].
# Mirrors the pattern used by ~/.hermes/scripts/github_app_cred.sh for the
# Hermes executor's GitHub App identity, but resolves a static personal PAT
# instead of minting a short-lived App installation token.
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
VENV_PY="$HOME/.hermes/hermes-agent/venv/bin/python"
RESOLVER="$HOME/.hermes/scripts/git_credential_op.py"
TOKEN="$("$VENV_PY" "$RESOLVER" 2>/dev/null || true)"
[ -n "$TOKEN" ] || exit 0   # fail open -> git falls back to other helpers
printf 'username=colingreig\n'
printf 'password=%s\n' "$TOKEN"
