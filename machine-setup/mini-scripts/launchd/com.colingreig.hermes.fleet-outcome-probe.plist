<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.colingreig.hermes.fleet-outcome-probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/colingreig/.hermes/scripts/fleet_outcome_probe.py</string>
    <string>--contracts</string>
    <string>/Users/colingreig/.hermes/scripts/fleet_outcome_contracts.json</string>
