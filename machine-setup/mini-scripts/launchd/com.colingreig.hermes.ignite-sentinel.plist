<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.colingreig.hermes.ignite-sentinel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/colingreig/.hermes/scripts/sentinel_run.sh</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/colingreig/.hermes/logs/ignite-sentinel-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/colingreig/.hermes/logs/ignite-sentinel-launchd.log</string>
    <key>StartInterval</key>
    <integer>900</integer>
</dict>
</plist>
