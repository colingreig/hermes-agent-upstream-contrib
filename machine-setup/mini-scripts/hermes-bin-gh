#!/usr/bin/env bash
# gh CLI wrapper for the Hermes Dev Assistant GitHub App.
# MINI DESTINATION: ~/.hermes/bin/gh  (NOT ~/.hermes/scripts/)
#
# Mints a fresh short-lived installation token per invocation via op-run
# (never caches/stores a token) so `gh` works non-interactively from any
# ssh/cron context and survives reboots without depending on the GUI login
# keychain or a static PAT. Falls back to real gh's own auth if minting fails
# (e.g. so `gh --version`/`gh help` still work offline).
#
# 2026-07-26 (cron-auth outage): the interpreter is now resolved ABSOLUTELY.
# The terminal tool builds its session env from a `bash -l` login shell, and
# /etc/profile's /usr/libexec/path_helper REORDERS PATH so /usr/local/bin and
# /opt/homebrew/bin land ahead of the Hermes venv. Bare `python3` therefore
# resolved to the python.org /usr/local/bin/python3 3.13 build, which has no
# CA bundle installed -> every mint died with
#   URLError(SSL: CERTIFICATE_VERIFY_FAILED ... unable to get local issuer certificate)
# and `2>/dev/null || true` swallowed it, leaving GH_TOKEN unset and every
# cron `gh` call reporting "no oauth token found for github.com".
# Mint failures are now logged instead of being silently discarded.
set -euo pipefail
REAL_GH="/opt/homebrew/bin/gh"

# --- merge-shadow gate (defense-in-depth; merge_guard hook is PRIMARY) --------
# A PR merge through this wrapper is refused (exit 13) unless the merge
# pipeline is ACTIVE. Mirrors validator_verdict.merge_shadow_active():
#   - absence of env = SHADOW  -> refuse (fail-closed default)
#   - HERMES_MERGE_ACTIVE truthy ({1,true,yes,on}) -> allow
#   - HERMES_MERGE_SHADOW truthy (emergency override) -> refuse, even when
#     HERMES_MERGE_ACTIVE is set — shadow always wins
#   - legacy VALIDATE_SHADOW truthy also refuses (kept as a closing-only var)
# The retired HERMES_AUTONOMOUS_MERGE master switch is deliberately NOT
# consulted here: tier policy is enforced upstream (merge_guard +
# hermes_validate_ops), and high-tier PRs are never autonomously mergeable.
_truthy() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}
_is_merge_attempt() {
  local prev="" arg
  for arg in "$@"; do
    case "$arg" in
      merge) [ "$prev" = "pr" ] && return 0 ;;
      *pulls/*/merge*|*/merges|*/merges\?*) return 0 ;;
    esac
    prev="$arg"
  done
  return 1
}
if _is_merge_attempt "$@"; then
  if _truthy "${HERMES_MERGE_SHADOW:-}" || _truthy "${VALIDATE_SHADOW:-}" \
      || ! _truthy "${HERMES_MERGE_ACTIVE:-}"; then
    echo "gh-wrapper: PR merge REFUSED (shadow mode: HERMES_MERGE_ACTIVE not" \
      "enabled, or HERMES_MERGE_SHADOW/VALIDATE_SHADOW override set)." \
      "High-risk-tier PRs always require a human merge." >&2
    exit 13
  fi
fi

# Absolute interpreter: never trust PATH here (see header).
HERMES_PY="$HOME/.hermes/runtime-current/venv/bin/python"
[ -x "$HERMES_PY" ] || HERMES_PY="/usr/bin/python3"

MINT_LOG="$HOME/.hermes/logs/github-app-token.log"
ERR_FILE="$(mktemp -t hermes-gh-mint)"
TOKEN="$("$HOME/.local/bin/op-run" \
  --env-file "$HOME/.hermes/github-app.op-env" -- \
  "$HERMES_PY" "$HOME/.hermes/scripts/github_app_token.py" 2>"$ERR_FILE" || true)"

if [ -n "$TOKEN" ]; then
  export GH_TOKEN="$TOKEN"
else
  # Never silent: a swallowed mint failure is what made the 2026-07-26
  # cron-auth outage invisible for two days.
  printf '%s gh-wrapper: GitHub App token mint FAILED (py=%s): %s\n' \
    "$(date -u +%FT%TZ)" "$HERMES_PY" \
    "$(tr '\n' ' ' <"$ERR_FILE" | tail -c 600)" >>"$MINT_LOG" 2>/dev/null || true
fi
rm -f "$ERR_FILE"

exec "$REAL_GH" "$@"
