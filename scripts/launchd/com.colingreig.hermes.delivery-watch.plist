<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.colingreig.hermes.delivery-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/colingreig/.hermes/runtime-current/scripts/hermes_delivery_watch.py</string>
        <string>--once</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/colingreig</string>
        <key>HERMES_HOME</key>
        <string>/Users/colingreig/.hermes</string>
        <key>PATH</key>
        <string>/Users/colingreig/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>/Users/colingreig/.hermes/logs/delivery-watch.err.log</string>
    <key>StandardOutPath</key>
    <string>/Users/colingreig/.hermes/logs/delivery-watch.log</string>
</dict>
</plist>
